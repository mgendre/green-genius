{
  "openapi": "3.1.1",
  "info": {
    "title": "GreenGenius.App | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/gardens": {
      "post": {
        "tags": [
          "GreenGenius.App"
        ],
        "operationId": "CreateGarden",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGardenDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GardenDto"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "GreenGenius.App"
        ],
        "operationId": "ListGardens",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GardenDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/gardens/{id}": {
      "put": {
        "tags": [
          "GreenGenius.App"
        ],
        "operationId": "UpdateGarden",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGardenDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GardenDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "GreenGenius.App"
        ],
        "operationId": "DeleteGarden",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/plants": {
      "get": {
        "tags": [
          "GreenGenius.App"
        ],
        "operationId": "ListPlants",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlantSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/plants/{id}": {
      "get": {
        "tags": [
          "GreenGenius.App"
        ],
        "operationId": "GetPlant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlantDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateGardenDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "GardenDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PlantDto": {
        "required": [
          "nameFr",
          "needs",
          "traits"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nameFr": {
            "type": "string"
          },
          "nameLatin": {
            "type": [
              "null",
              "string"
            ]
          },
          "descriptionFr": {
            "type": [
              "null",
              "string"
            ]
          },
          "family": {
            "$ref": "#/components/schemas/PlantFamily"
          },
          "lifeCycle": {
            "$ref": "#/components/schemas/PlantLifeCycle"
          },
          "daysToMaturity": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureMinC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "needs": {
            "$ref": "#/components/schemas/PlantNeedsDto"
          },
          "traits": {
            "$ref": "#/components/schemas/PlantTraitsDto"
          }
        }
      },
      "PlantFamily": {
        "enum": [
          "Solanaceae",
          "Brassicaceae",
          "Fabaceae",
          "Apiaceae",
          "Cucurbitaceae",
          "Amaryllidaceae",
          "Asteraceae",
          "Amaranthaceae",
          "Poaceae",
          "Lamiaceae",
          "Rosaceae",
          "Polygonaceae",
          "Other"
        ]
      },
      "PlantLifeCycle": {
        "enum": [
          "Annual",
          "Biennial",
          "Perennial"
        ]
      },
      "PlantNeedsDto": {
        "type": "object",
        "properties": {
          "sunlight": {
            "$ref": "#/components/schemas/SunlightLevel"
          },
          "waterNeed": {
            "$ref": "#/components/schemas/WaterNeedLevel"
          },
          "rootDepth": {
            "$ref": "#/components/schemas/RootDepthLevel"
          },
          "soilpHMin": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "soilpHMax": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "spacingRowCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "spacingPlantCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "heightCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "spreadCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PlantSummaryDto": {
        "required": [
          "nameFr",
          "family"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nameFr": {
            "type": "string"
          },
          "nameLatin": {
            "type": [
              "null",
              "string"
            ]
          },
          "family": {
            "type": "string"
          }
        }
      },
      "PlantTraitsDto": {
        "type": "object",
        "properties": {
          "nitrogenFixer": {
            "type": "boolean"
          },
          "dynamicAccumulator": {
            "type": "boolean"
          },
          "pollinatorFriendly": {
            "type": "boolean"
          },
          "droughtTolerant": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RootDepthLevel": {
        "enum": [
          "Shallow",
          "Medium",
          "Deep"
        ]
      },
      "SunlightLevel": {
        "enum": [
          "Low",
          "Medium",
          "High"
        ]
      },
      "UpdateGardenDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "WaterNeedLevel": {
        "enum": [
          "Low",
          "Medium",
          "High"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "GreenGenius.App"
    }
  ]
}