  "components": {
    "schemas": {
      "BedDto": {
        "required": [
          "id",
          "name",
          "gardenId",
          "plants"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "gardenId": {
            "type": "string",
            "format": "uuid"
          },
          "plants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlantSummaryDto"
            }
          }
        }
      },
      "CreateBedDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "CreateGardenDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Effect": {
        "enum": [
          "Beneficial",
          "Antagonistic"
        ]
      },
      "Evidence": {
        "enum": [
          "Established",
          "Limited"
        ]
      },
      "GardenDto": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Mechanism": {
        "enum": [
          "NitrogenFixation",
          "PestDeterrent",
          "TrapCrop",
          "PredatorAttraction",
          "PollinatorAttraction",
          "PhysicalSupport",
          "ShadeOrShelter",
          "GroundCover",
          "RootComplementarity",
          "NutrientAccumulation",
          "SharedPestOrDisease",
          "Allelopathy",
          "ResourceCompetition"
        ]
      },
      "PlantAssociationDto": {
        "required": [
          "plantA",
          "plantB",
          "effect",
          "mechanisms",
          "evidence"
        ],
        "type": "object",
        "properties": {
          "plantA": {
            "$ref": "#/components/schemas/PlantSummaryDto"
          },
          "plantB": {
            "$ref": "#/components/schemas/PlantSummaryDto"
          },
          "effect": {
            "$ref": "#/components/schemas/Effect"
          },
          "mechanisms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Mechanism"
            }
          },
          "evidence": {
            "$ref": "#/components/schemas/Evidence"
          },
          "noteFr": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PlantDto": {
        "required": [
          "id",
          "nameFr",
          "family",
          "lifeCycle",
          "needs",
          "traits"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nameFr": {
            "type": "string"
          },
          "binomialName": {
            "type": [
              "null",
              "string"
            ]
          },
          "emoji": {
            "type": [
              "null",
              "string"
            ]
          },
          "descriptionFr": {
            "type": [
              "null",
              "string"
            ]
          },
          "family": {
            "$ref": "#/components/schemas/PlantFamily"
          },
          "lifeCycle": {
            "$ref": "#/components/schemas/PlantLifeCycle"
          },
          "frostToleranceC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "needs": {
            "$ref": "#/components/schemas/PlantNeedsDto"
          },
          "traits": {
            "$ref": "#/components/schemas/PlantTraitsDto"
          }
        }
      },
      "PlantFamily": {
        "enum": [
          "Solanaceae",
          "Brassicaceae",
          "Fabaceae",
          "Apiaceae",
          "Cucurbitaceae",
          "Amaryllidaceae",
          "Asteraceae",
          "Amaranthaceae",
          "Poaceae",
          "Lamiaceae",
          "Rosaceae",
          "Polygonaceae",
          "Other"
        ]
      },
      "PlantLifeCycle": {
        "enum": [
          "Annual",
          "Biennial",
          "Perennial"
        ]
      },
      "PlantNeedsDto": {
        "required": [
          "sunlight",
          "waterNeed",
          "rootDepth",
          "spacingRowCm",
          "spacingPlantCm",
          "heightCm",
          "spreadCm"
        ],
        "type": "object",
        "properties": {
          "sunlight": {
            "$ref": "#/components/schemas/SunlightLevel"
          },
          "waterNeed": {
            "$ref": "#/components/schemas/WaterNeedLevel"
          },
          "rootDepth": {
            "$ref": "#/components/schemas/RootDepthLevel"
          },
          "soilPhMin": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "soilPhMax": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "spacingRowCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "spacingPlantCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "heightCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "spreadCm": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PlantSummaryDto": {
        "required": [
          "id",
          "nameFr",
          "family"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nameFr": {
            "type": "string"
          },
          "binomialName": {
            "type": [
              "null",
              "string"
            ]
          },
          "emoji": {
            "type": [
              "null",
              "string"
            ]
          },
          "family": {
            "$ref": "#/components/schemas/PlantFamily"
          }
        }
      },
      "PlantTraitsDto": {
        "required": [
          "nitrogenFixer",
          "dynamicAccumulator",
          "pollinatorFriendly",
          "droughtTolerant"
        ],
        "type": "object",
        "properties": {
          "nitrogenFixer": {
            "type": "boolean"
          },
          "dynamicAccumulator": {
            "type": "boolean"
          },
          "pollinatorFriendly": {
            "type": "boolean"
          },
          "droughtTolerant": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RootDepthLevel": {
        "enum": [
          "Shallow",
          "Medium",
          "Deep"
        ]
      },
      "SunlightLevel": {
        "enum": [
          "Low",
          "Medium",
          "High"
        ]
      },
      "UpdateBedDto": {
        "required": [
          "name",
          "plantIds"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "plantIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "UpdateGardenDto": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "WaterNeedLevel": {
        "enum": [
          "Low",
          "Medium",
          "High"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Gardens"
    },
    {
      "name": "Plants"
    },
    {
      "name": "Beds"
    }
  ]
}