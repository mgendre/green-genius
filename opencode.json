{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.6",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "context7_*": "deny",
    "angular-cli_*": "deny",
    "spartan-ui_*": "deny",
    "skill": {
      "dispatcher-plan": "deny",
      "opencode-skill-creator": "deny",
      "sonar-api": "deny"
    },
    "bash": {
      "rm *": "allow",
      "mv *": "allow",
      "rm *..*": "deny",
      "rm *~*": "deny",
      "rm *$*": "deny",
      "rm *.git": "deny",
      "rm *.git *": "deny",
      "rm *.git/*": "deny",
      "rm *.plans*": "deny",
      "rm *node_modules*": "deny",
      "mv *..*": "deny",
      "mv *~*": "deny",
      "mv *$*": "deny",
      "mv *.git": "deny",
      "mv *.git *": "deny",
      "mv *.git/*": "deny",
      "mv *.plans*": "deny",
      "mv *node_modules*": "deny",
      "* *.env*": "deny",
      "* *.apikey*": "deny",
      "* *.ssh*": "deny"
    },
    "edit": {
      "**/.opencode/**": "allow",
      "**/.github/**": "allow",
      "**/dotnet-tools.json": "allow"
    }
  },
  "lsp": {
    "csharp": {
      "disabled": true
    },
    "yaml-ls": {
      "disabled": true
    },
    "bash": {
      "disabled": true
    },
    "dockerfile": {
      "disabled": true
    }
  },
  "default_agent": "dispatcher"
}
