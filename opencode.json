{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.6",
  "small_model": "ollama/qwen3.6-none",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "permission": {
    "context7_*": "deny",
    "angular-cli_*": "deny",
    "spartan-ui_*": "deny",
    "skill": {
      "dispatcher-plan": "deny",
      "opencode-skill-creator": "deny",
      "sonar-api": "deny"
    },
    "bash": {
      "rm *": "allow",
      "mv *": "allow",
      "rm *..*": "deny",
      "rm *~*": "deny",
      "rm *$*": "deny",
      "mv *..*": "deny",
      "mv *~*": "deny",
      "mv *$*": "deny",
      "rm *.git": "deny",
      "rm *.git *": "deny",
      "rm *.git/*": "deny",
      "rm *.github*": "deny",
      "rm *.opencode*": "deny",
      "rm *.agents*": "deny",
      "rm *AGENTS.md*": "deny",
      "rm *node_modules*": "deny",
      "rm *opencode.json*": "deny",
      "rm *.env*": "deny",
      "rm *.apikey*": "deny",
      "rm *.ssh*": "deny",
      "mv *.git": "deny",
      "mv *.git *": "deny",
      "mv *.git/*": "deny",
      "mv *.github*": "deny",
      "mv *.opencode*": "deny",
      "mv *.agents*": "deny",
      "mv *AGENTS.md*": "deny",
      "mv *node_modules*": "deny",
      "mv *opencode.json*": "deny",
      "mv *.env*": "deny",
      "mv *.apikey*": "deny",
      "mv *.ssh*": "deny"
    }
  },
  "lsp": {
    "csharp": {
      "disabled": true
    },
    "yaml-ls": {
      "disabled": true
    },
    "bash": {
      "disabled": true
    },
    "dockerfile": {
      "disabled": true
    }
  },
  "default_agent": "dispatcher"
}
