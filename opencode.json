{
  "$schema": "https://opencode.ai/config.json",
  "model": "strata/swift",
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "angular-cli": {
        "type": "local",
        "command": ["npx", "-y", "@angular/cli@22.2.1", "mcp", "--read-only", "--root", "."],
        "cwd": "GreenGenius.Frontend"
      },
      "spartan-ui": {
        "type": "local",
        "command": ["npx", "-y", "@spartan-ng/mcp@1.5.0"]
      }
    }
  },
  "permissions": [
    { "action": "context7_*", "resource": "*", "effect": "deny" },
    { "action": "angular-cli_*", "resource": "*", "effect": "deny" },
    { "action": "spartan-ui_*", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "dispatcher-plan", "effect": "deny" },
    { "action": "skill", "resource": "opencode-skill-creator", "effect": "deny" },
    { "action": "skill", "resource": "sonar-api", "effect": "deny" },
    { "action": "shell", "resource": "rm *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "rm *..*", "effect": "deny" },
    { "action": "shell", "resource": "rm *~*", "effect": "deny" },
    { "action": "shell", "resource": "rm *$*", "effect": "deny" },
    { "action": "shell", "resource": "rm *.git", "effect": "deny" },
    { "action": "shell", "resource": "rm *.git *", "effect": "deny" },
    { "action": "shell", "resource": "rm *.git/*", "effect": "deny" },
    { "action": "shell", "resource": "rm *.plans*", "effect": "deny" },
    { "action": "shell", "resource": "rm *node_modules*", "effect": "deny" },
    { "action": "shell", "resource": "mv *..*", "effect": "deny" },
    { "action": "shell", "resource": "mv *~*", "effect": "deny" },
    { "action": "shell", "resource": "mv *$*", "effect": "deny" },
    { "action": "shell", "resource": "mv *.git", "effect": "deny" },
    { "action": "shell", "resource": "mv *.git *", "effect": "deny" },
    { "action": "shell", "resource": "mv *.git/*", "effect": "deny" },
    { "action": "shell", "resource": "mv *.plans*", "effect": "deny" },
    { "action": "shell", "resource": "mv *node_modules*", "effect": "deny" },
    { "action": "shell", "resource": "* *.env*", "effect": "deny" },
    { "action": "shell", "resource": "* *.apikey*", "effect": "deny" },
    { "action": "shell", "resource": "* *usersecrets*", "effect": "deny" },
    { "action": "shell", "resource": "rm /*", "effect": "deny" },
    { "action": "shell", "resource": "rm * /*", "effect": "deny" },
    { "action": "shell", "resource": "mv /*", "effect": "deny" },
    { "action": "shell", "resource": "mv * /*", "effect": "deny" },
    { "action": "shell", "resource": "* *.ssh*", "effect": "deny" },
    { "action": "shell", "resource": "* *.gnupg*", "effect": "deny" },
    { "action": "shell", "resource": "* *.config/gh*", "effect": "deny" },
    { "action": "shell", "resource": "* *.local/share/opencode*", "effect": "deny" },
    { "action": "shell", "resource": "* *opencode.json*", "effect": "deny" },
    { "action": "shell", "resource": "* *.opencode/*", "effect": "deny" },
    { "action": "shell", "resource": "* *.github/*", "effect": "deny" },
    { "action": "shell", "resource": "* *AGENTS.md*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "~/.nuget/packages/*", "effect": "allow" },
    { "action": "read", "resource": "*usersecrets*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/*", "effect": "deny" },
    { "action": "edit", "resource": "~/*", "effect": "deny" },
    { "action": "edit", "resource": "opencode.json", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/*", "effect": "deny" },
    { "action": "edit", "resource": ".github/*", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "*/AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "**/dotnet-tools.json", "effect": "allow" },
    { "action": "edit", "resource": "**/.git/**", "effect": "deny" }
  ],
  "agents": {
    "title": { "model": "strata/swift#none" },
    "summary": { "model": "strata/swift#none" },
    "compaction": { "model": "strata/swift#low" },
    "explore": { "model": "strata/swift#low" },
    "general": { "model": "strata/swift#low" },
    "build": {
      "permissions": [
        { "action": "edit", "resource": "opencode.json", "effect": "allow" },
        { "action": "edit", "resource": ".opencode/*", "effect": "allow" },
        { "action": "edit", "resource": ".github/*", "effect": "allow" },
        { "action": "edit", "resource": "AGENTS.md", "effect": "allow" },
        { "action": "edit", "resource": "*/AGENTS.md", "effect": "allow" }
      ]
    }
  },
  "lsp": {
    "csharp": {
      "disabled": true
    },
    "yaml-ls": {
      "disabled": true
    },
    "bash": {
      "disabled": true
    },
    "dockerfile": {
      "disabled": true
    }
  },
  "default_agent": "dispatcher"
}
